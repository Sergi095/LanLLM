#!/usr/bin/env python3
"""Host command for the LanLLM pool; status does not require Docker."""

import argparse
import ipaddress
import json
import os
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from collections import defaultdict, deque
from pathlib import Path
from urllib.error import HTTPError
from urllib.parse import urlparse
from urllib.request import Request, urlopen

REPOSITORY = Path(__file__).resolve().parents[1]
MANAGED_STORES = Path("/var/lib/lanllm/model-dirs")
sys.path.insert(0, str(REPOSITORY))

from lanllm.cluster import (  # noqa: E402
    MODEL_ID_PATTERN,
    format_status,
    local_ip_for,
    query_node,
    selected_model,
    selected_model_fit,
    selected_spec,
    verify_model_store,
)
from lanllm.model_sources import parse_source  # noqa: E402
from lanllm.dashboard import poll_nodes, render_dashboard, run_dashboard  # noqa: E402


def configuration() -> dict[str, str]:
    values = {}
    path = REPOSITORY / ".env"
    if path.exists():
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                key, separator, value = line.partition("=")
                if separator:
                    values[key.strip()] = value.strip()
    config_path = REPOSITORY / "lanllm.conf"
    if config_path.exists():
        with config_path.open("rb") as source:
            config = tomllib.load(source)
        cluster = config.get("cluster", {})
        models = config.get("models", {})
        if "profiles" in models:
            values["MODEL_PROFILES_JSON"] = json.dumps(models["profiles"])
        inference = config.get("inference", {})
        api = config.get("api", {})
        if "peers" in cluster:
            peers = cluster["peers"]
            if not isinstance(peers, list) or not all(
                isinstance(peer, str) for peer in peers
            ):
                raise ValueError("cluster.peers must be a list of IP addresses")
            values["PEER_IPS"] = ",".join(peers)
        mapping = (
            (cluster, "total_gpus", "TOTAL_GPUS"),
            (models, "directory", "MODEL_STORE_DIR"),
            (models, "default_id", "MODEL_ID"),
            (models, "revision", "HF_REVISION"),
            (models, "token", "HF_TOKEN"),
            (inference, "max_model_len", "MAX_MODEL_LEN"),
            (inference, "gpu_memory_utilization", "GPU_MEMORY_UTILIZATION"),
            (inference, "layer_partition", "LAYER_PARTITION"),
            (inference, "quantization", "QUANTIZATION"),
            (inference, "dtype", "DTYPE"),
            (inference, "trust_remote_code", "TRUST_REMOTE_CODE"),
            (inference, "llama_rpc_port", "LLAMA_RPC_PORT"),
            (api, "port", "API_PORT"),
            (api, "control_port", "CONTROL_PORT"),
        )
        for section, key, env_name in mapping:
            if key in section:
                value = section[key]
                values[env_name] = (
                    ("1" if value else "0") if isinstance(value, bool) else str(value)
                )
        if "MODEL_STORE_DIR" in values:
            values["MODEL_STORE_DIR"] = str(
                Path(values["MODEL_STORE_DIR"]).expanduser()
            )
    return values


def model_store(values: dict[str, str]) -> Path:
    path = Path(values.get("MODEL_STORE_DIR", "/srv/lanllm-store"))
    if (
        not path.is_absolute()
        or len(path.parts) < 3
        or any(char.isspace() for char in str(path))
    ):
        raise ValueError("models.directory must be an absolute path without spaces")
    if path.is_symlink():
        raise ValueError("models.directory cannot be a symlink")
    return path


def status() -> int:
    values = configuration()
    peers = [ip.strip() for ip in values.get("PEER_IPS", "").split(",") if ip.strip()]
    if not peers:
        raise ValueError("PEER_IPS is missing from the LanLLM .env file")
    port = int(values.get("CONTROL_PORT", "8501"))
    api_port = int(values.get("API_PORT", "8001"))
    states = []
    offline = []
    for ip in peers:
        state = query_node(ip, port, timeout=2, full=True)
        if state is None:
            offline.append(ip)
        else:
            states.append(state)
    print(format_status(states, offline, api_port))
    return 0 if states else 1


def leader_endpoint(values: dict[str, str], endpoint: str) -> dict:
    with urlopen(leader_url(values, endpoint), timeout=10) as response:
        return json.load(response)


def leader_url(values: dict[str, str], endpoint: str) -> str:
    port = int(values.get("CONTROL_PORT", "8501"))
    states = [query_node(ip, port, timeout=2) for ip in peer_ips(values)]
    leaders = [state for state in states if state and state["role"] == "leader"]
    if not leaders:
        raise ValueError("No LanLLM leader is online")
    return f"http://{leaders[0]['node_ip']}:{port}/{endpoint}"


def post_leader(
    values: dict[str, str], endpoint: str, data: dict, timeout: int = 15
) -> dict:
    request = Request(
        leader_url(values, endpoint),
        data=json.dumps(data).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urlopen(request, timeout=timeout) as response:
            return json.load(response)
    except HTTPError as exc:
        try:
            detail = json.load(exc).get("error")
        except (ValueError, AttributeError):
            detail = None
        raise ValueError(
            detail or f"Leader rejected request: HTTP {exc.code} {exc.reason}"
        ) from exc


def download(source: str | None, backend: str | None, filename: str) -> int:
    values = configuration()
    if source:
        spec = parse_source(source, backend, filename)
        post_leader(
            values, "download", {"source": source, "backend": backend, "file": filename}
        )
        print(f"Downloading {spec['ref']} on the leader")
    elif backend or filename:
        raise ValueError("A model source is required with --backend or --file")
    previous = ""
    while True:
        with urlopen(leader_url(values, "download"), timeout=10) as response:
            job = json.load(response)
        total, current = job.get("total_bytes", 0), job.get("downloaded_bytes", 0)
        progress = f" {current / 2**30:.2f}/{total / 2**30:.2f} GiB" if total else ""
        line = f"{job.get('stage', job['status'])}{progress}"
        if line != previous:
            print(line, flush=True)
            previous = line
        if job["status"] == "ready":
            print(f"Ready: {job['ref']}. Serve it with: lanllm model switch {job['ref']}")
            return 0
        if job["status"] == "error":
            raise ValueError(job.get("error", "Download failed"))
        if job["status"] == "idle":
            print("No model download is running")
            return 0
        time.sleep(2)


def fit(source: str, backend: str | None, filename: str, apply: bool) -> int:
    values = configuration()
    plan = post_leader(
        values,
        "fit",
        {"source": source, "backend": backend, "file": filename},
        timeout=60,
    )
    print(
        f"Online GPUs: {plan['online_gpus']}/{plan['required_gpus']}  |  "
        f"Usable VRAM: leader {plan['leader_usable_bytes'] / 2**30:.1f} GiB, "
        f"online pool {plan['online_usable_bytes'] / 2**30:.1f} GiB"
    )
    print()
    for item in plan["variants"]:
        marker = "*" if item == plan["recommended"] else " "
        size = item["weight_bytes"] / 2**30
        fit_label = {"leader": "leader", "pool": "pool", "too_large": "too large"}[item["fit"]]
        if item["tight"] and item["fit"] != "too_large":
            fit_label += ", tight"
        print(f"{marker} {item['ref']}")
        print(f"    {size:.1f} GiB  |  {item['backend']}  |  {fit_label}")
    print("\n* Recommended. Estimate reserves 2 GiB per GPU and prefers 10% extra headroom.")
    print("  Actual runtime fit also depends on context, architecture, and backend.")
    recommendation = plan["recommended"]
    if recommendation is None:
        print("No variant fits the GPUs currently online. Try a quantized model repository.")
        if apply:
            raise ValueError("No fitting variant to download")
        return 0
    if apply:
        if (
            recommendation["fit"] == "pool"
            and plan["online_gpus"] < plan["required_gpus"]
        ):
            raise ValueError("Start the missing GPU worker before applying a model fit")
        download(
            recommendation["source"],
            recommendation["backend"],
            recommendation["file"],
        )
        return model(recommendation["ref"])
    command = [
        "lanllm", "fit", recommendation["source"],
        "--backend", recommendation["backend"],
    ]
    if recommendation["file"]:
        command += ["--file", recommendation["file"]]
    command.append("--apply")
    print("\nDownload and switch: " + shlex.join(command))
    return 0


def top(once: bool, interval: float) -> int:
    if not 0.5 <= interval <= 10:
        raise ValueError("--interval must be between 0.5 and 10 seconds")
    values = configuration()
    peers = peer_ips(values)
    port = int(values.get("CONTROL_PORT", "8501"))
    api_port = int(values.get("API_PORT", "8001"))
    if once or not sys.stdout.isatty():
        states, offline = poll_nodes(peers, port)
        history = defaultdict(lambda: deque(maxlen=30))
        print("\n".join(render_dashboard(
            states, offline, shutil.get_terminal_size((80, 24)).columns,
            api_port, history,
        )))
        return 0 if states else 1
    return run_dashboard(peers, port, api_port, interval)


def nodes() -> int:
    data = leader_endpoint(configuration(), "nodes")
    entries = data["nodes"]
    registered = sum(bool(node["gpus"]) for node in entries)
    online = sum(node["online"] for node in entries)
    print(f"LanLLM nodes: {registered} registered, {online} online")
    print(
        f"{'Node':<17} {'Role':<10} {'GPUs':>4} {'VRAM':>12} "
        f"{'CPUs':>5} {'RAM':>9}  GPU names"
    )
    for node in entries:
        gpus = node["gpus"]
        total_mib = sum(int(gpu["total_mib"]) for gpu in gpus)
        names = ", ".join(gpu["name"] for gpu in gpus) or "not registered"
        cpus = str(node["cpus"]) if node["cpus"] is not None else "?"
        ram = (
            f"{node['ram_total_gib']:.1f} GiB"
            if node["ram_total_gib"] is not None
            else "?"
        )
        print(
            f"{node['node_ip']:<17} {node['role']:<10} {len(gpus):>4} "
            f"{total_mib:>8,} MiB {cpus:>5} {ram:>9}  {names}"
        )
    return 0


def models() -> int:
    data = leader_endpoint(configuration(), "models")
    print(format_models(data, shutil.get_terminal_size((80, 24)).columns))
    return 0


def format_models(data: dict, terminal_width: int) -> str:
    leader_gib = data["leader_usable_mib"] / 1024
    pool_gib = data["registered_usable_mib"] / 1024
    lines = [
        f"Nodes: {data['online_nodes']}/{data['registered_nodes']} online  |  "
        f"Usable VRAM: leader {leader_gib:.1f} GiB, pool {pool_gib:.1f} GiB",
        "",
    ]
    if not data["models"]:
        return "\n".join([*lines, "No downloaded models in the leader store"])

    if terminal_width < 70:
        for entry in data["models"]:
            fit = model_fit_label(entry)
            gib = entry["weight_bytes"] / (1024**3)
            lines.extend(
                [
                    entry["model_id"],
                    f"  {gib:.1f} GiB  |  {entry.get('backend', 'vllm')}  |  {fit}",
                ]
            )
    else:
        name_width = min(
            max(len(entry["model_id"]) for entry in data["models"]),
            terminal_width - 45,
        )
        lines.append(
            f"{'MODEL':<{name_width}}  {'WEIGHTS':>10}  {'BACKEND':<9}  FIT"
        )
        lines.append("─" * min(terminal_width, name_width + 45))
        for entry in data["models"]:
            name = entry["model_id"]
            fit = model_fit_label(entry)
            gib = entry["weight_bytes"] / (1024**3)
            if len(name) > name_width:
                lines.append(name)
                name = ""
            lines.append(
                f"{name:<{name_width}}  {gib:>7.1f} GiB  "
                f"{entry.get('backend', 'vllm'):<9}  {fit}"
            )
    lines.extend(
        [
            "",
            "Fit: Leader = local GPUs; Pool = all registered GPUs. "
            "Reserves 2 GiB per GPU.",
        ]
    )
    return "\n".join(lines)


def model_fit_label(entry: dict) -> str:
    fit = {
        "leader": "Leader",
        "pool": "Pool",
        "too_large": "Too large",
        "unknown": "Unknown",
    }[entry["fit"]]
    if entry["fit"] == "pool" and not entry["fits_online_vram"]:
        fit += " (offline)"
    return fit


def peer_ips(values: dict[str, str]) -> list[str]:
    peers = [ip.strip() for ip in values.get("PEER_IPS", "").split(",") if ip.strip()]
    if not peers:
        raise ValueError("PEER_IPS is missing from the LanLLM .env file")
    for ip in peers:
        if not isinstance(ipaddress.ip_address(ip), ipaddress.IPv4Address):
            raise ValueError("LanLLM currently requires IPv4 peer addresses")
    return peers


def sudo(*command: str, input_text: str | None = None) -> None:
    subprocess.run(
        ["sudo", "-n", *command],
        input=input_text,
        text=True,
        stdout=subprocess.DEVNULL,
        check=True,
    )


def setup_store() -> None:
    values = configuration()
    store = model_store(values)
    peers = peer_ips(values)
    node_ip = values.get("NODE_IP", "").strip() or local_ip_for(peers[0])
    if node_ip not in peers:
        raise ValueError(f"This host's address {node_ip} is absent from PEER_IPS")
    if shutil.which("exportfs") is None and not Path("/usr/sbin/exportfs").exists():
        sudo("env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "update", "-qq")
        sudo(
            "env",
            "DEBIAN_FRONTEND=noninteractive",
            "apt-get",
            "install",
            "-y",
            "-qq",
            "nfs-kernel-server",
        )
        sudo("install", "-d", "-m", "0755", "/var/lib/lanllm")
        sudo(
            "tee",
            "/var/lib/lanllm/owned-nfs-server",
            input_text="installed-by-lanllm\n",
        )
    if store.exists() and not (store / ".lanllm-store").exists() and any(store.iterdir()):
        raise ValueError(f"Model directory is not empty: {store}")
    sudo("install", "-d", "-m", "0755", str(store))
    marker = store / ".lanllm-store"
    if not marker.exists():
        sudo("tee", str(marker), input_text="lanllm-model-store-v1\n")
    verify_model_store(store)
    sudo("install", "-d", "-m", "0755", "/var/lib/lanllm")
    recorded = (
        MANAGED_STORES.read_text().splitlines() if MANAGED_STORES.exists() else []
    )
    if str(store) not in recorded:
        sudo("tee", "-a", str(MANAGED_STORES), input_text=str(store) + "\n")
    sudo("install", "-d", "-m", "0755", "/etc/exports.d")
    clients = " ".join(
        f"{ip}(ro,sync,no_subtree_check,root_squash)" for ip in peers if ip != node_ip
    )
    if clients:
        sudo(
            "tee",
            "/etc/exports.d/lanllm.exports",
            input_text=f"{store} {clients}\n",
        )
    sudo("systemctl", "enable", "--now", "nfs-server")
    sudo("exportfs", "-ra")
    (Path.home() / ".cache/lanllm/vllm").mkdir(parents=True, exist_ok=True)


def other_nfs_exports() -> bool:
    files = [Path("/etc/exports"), *Path("/etc/exports.d").glob("*.exports")]
    for path in files:
        if path.name == "lanllm.exports" or not path.exists():
            continue
        if any(
            line.strip() and not line.lstrip().startswith("#")
            for line in path.read_text(encoding="utf-8").splitlines()
        ):
            return True
    return False


def uninstall(*, keep_source: bool, dry_run: bool) -> int:
    values = configuration()
    configured_store = model_store(values)
    recorded = (
        MANAGED_STORES.read_text().splitlines() if MANAGED_STORES.exists() else []
    )
    stores = [
        model_store({"MODEL_STORE_DIR": value})
        for value in dict.fromkeys([*recorded, str(configured_store)])
    ]
    for store in stores:
        if not store.exists():
            continue
        verify_model_store(store)
        allowed = {
            ".lanllm-store",
            ".lanllm-model",
            ".lanllm-selection.json",
            ".lanllm-nodes.json",
            "models",
            "tokenizers",
            "gguf",
            ".hf-cache",
        }
        unknown = [
            entry.name
            for entry in store.iterdir()
            if entry.name not in allowed
            and not entry.name.startswith(".lanllm-model.")
            and not entry.name.startswith(".lanllm-selection.")
            and not entry.name.startswith(".lanllm-nodes.")
        ]
        if unknown:
            raise ValueError(f"Model directory contains unrecognized files: {unknown}")
    if dry_run:
        print("Would stop and remove the LanLLM container and image")
        for store in stores:
            if store.exists():
                print(f"Would remove model directory: {store}")
        cache = Path.home() / ".cache/lanllm"
        if cache.exists():
            print(f"Would remove project cache: {cache}")
        if Path("/etc/exports.d/lanllm.exports").exists():
            print("Would remove NFS export: /etc/exports.d/lanllm.exports")
        if Path("/var/lib/lanllm/owned-nfs-server").exists():
            print("Would remove the NFS server package if no other exports need it")
        print("Would remove /usr/local/bin/lanllm if it points to this checkout")
        if not keep_source:
            print(f"Would remove repository checkout: {REPOSITORY}")
        return 0
    environment = os.environ.copy() | values
    subprocess.run(
        ["docker", "compose", "down", "--remove-orphans"],
        cwd=REPOSITORY,
        env=environment,
        check=True,
    )
    export = Path("/etc/exports.d/lanllm.exports")
    if export.exists():
        sudo("rm", "--", str(export))
        sudo("exportfs", "-ra")
    for store in stores:
        if store.exists():
            sudo("rm", "-r", "--", str(store))
    cache = Path.home() / ".cache/lanllm"
    if cache.exists():
        sudo("rm", "-r", "--", str(cache))
    image_exists = (
        subprocess.run(
            ["docker", "image", "inspect", "lanllm:local"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode
        == 0
    )
    if image_exists:
        subprocess.run(["docker", "image", "rm", "lanllm:local"], check=True)
    package_marker = Path("/var/lib/lanllm/owned-nfs-server")
    if package_marker.exists():
        if not other_nfs_exports():
            sudo("systemctl", "disable", "--now", "nfs-server")
            sudo(
                "env",
                "DEBIAN_FRONTEND=noninteractive",
                "apt-get",
                "remove",
                "--purge",
                "-y",
                "nfs-kernel-server",
            )
        sudo("rm", "--", str(package_marker))
    if MANAGED_STORES.exists():
        sudo("rm", "--", str(MANAGED_STORES))
    state_dir = Path("/var/lib/lanllm")
    if state_dir.exists() and not any(state_dir.iterdir()):
        sudo("rmdir", str(state_dir))
    command = Path("/usr/local/bin/lanllm")
    if command.is_symlink() and command.resolve() == REPOSITORY / "bin/lanllm":
        sudo("rm", "--", str(command))
    if not keep_source:
        shutil.rmtree(REPOSITORY)
    print("LanLLM removed from this node")
    return 0


def model(model_id: str | None) -> int:
    values = configuration()
    store = model_store(values)
    states = [
        query_node(ip, int(values.get("CONTROL_PORT", "8501")), timeout=2, full=True)
        for ip in peer_ips(values)
    ]
    leaders = [state for state in states if state and state["role"] == "leader"]
    leader = leaders[0] if leaders else None
    if model_id is None:
        current = leader["model_id"] if leader else None
        selection = selected_spec(store)
        print(current or (selection and selection["ref"]) or values.get("MODEL_ID", ""))
        return 0
    if model_id.startswith("https://"):
        model_id = parse_source(model_id)["ref"]
    if model_id.startswith("hf:") and "@" in model_id:
        repo, filename = model_id.removeprefix("hf:").rsplit("@", 1)
        parse_source("hf:" + repo, "llama.cpp", filename)
    elif model_id.startswith("ollama:"):
        model_id = parse_source(model_id)["ref"]
    elif not MODEL_ID_PATTERN.fullmatch(model_id) or ".." in model_id:
        raise ValueError(
            "model must be a downloaded model reference or Hugging Face ID"
        )
    if leader is None:
        raise ValueError("Start the GPU pool before selecting a model")
    catalog = leader_endpoint(values, "models")
    fit = selected_model_fit(catalog, model_id)
    if fit == "too_large":
        raise ValueError("Selected model exceeds the registered GPU pool capacity")
    online_gpus = sum(len(state["gpus"]) for state in states if state)
    required_gpus = (
        len(leader["gpus"]) if fit == "leader"
        else int(values.get("TOTAL_GPUS", "3"))
    )
    if online_gpus < required_gpus:
        raise ValueError(
            f"Only {online_gpus}/{required_gpus} GPUs are online; "
            "start the missing worker before selecting a model"
        )
    post_leader(values, "model", {"model_id": model_id})
    required_peers = [leader["node_ip"]] if fit == "leader" else peer_ips(values)
    address_word = "address" if len(required_peers) == 1 else "addresses"
    print(
        f"Selected {model_id}; waiting for {len(required_peers)} API {address_word}",
        flush=True,
    )
    wait_for_model_ready(values, model_id, peers=required_peers)
    print(f"Ready: {model_id} on {', '.join(required_peers)}")
    return 0


def wait_for_model_ready(
    values: dict[str, str], model_id: str, timeout: int = 600,
    peers: list[str] | None = None,
) -> None:
    peers = peers or peer_ips(values)
    port = int(values.get("API_PORT", "8001"))
    deadline = time.monotonic() + timeout
    last_report = 0.0
    while True:
        ready = []
        for ip in peers:
            try:
                with urlopen(f"http://{ip}:{port}/v1/models", timeout=3) as response:
                    listing = json.load(response)
                if model_id in {item["id"] for item in listing["data"]}:
                    ready.append(ip)
            except (OSError, ValueError, KeyError, TypeError):
                pass
        if len(ready) == len(peers):
            return
        now = time.monotonic()
        if now >= deadline:
            missing = ", ".join(ip for ip in peers if ip not in ready)
            raise ValueError(
                f"Model was not ready within {timeout}s on {missing}; check 'lanllm logs'"
            )
        if now - last_report >= 15:
            print(f"Loading {model_id}: {len(ready)}/{len(peers)} API addresses ready", flush=True)
            last_report = now
        time.sleep(2)


def main() -> int:
    parser = argparse.ArgumentParser(prog="lanllm")
    parser.add_argument(
        "action",
        nargs="?",
        default="status",
        choices=(
            "status",
            "nodes",
            "models",
            "top",
            "fit",
            "download",
            "start",
            "stop",
            "logs",
            "model",
            "switch",
            "uninstall",
        ),
    )
    parser.add_argument("model_id", nargs="?")
    parser.add_argument("switch_model_id", nargs="?")
    parser.add_argument("--apply", action="store_true", help="Download and switch to the recommended fit")
    parser.add_argument("--once", action="store_true", help="Print one dashboard snapshot")
    parser.add_argument("--interval", type=float, default=1.0, help="Dashboard refresh in seconds")
    parser.add_argument("--backend", choices=("vllm", "llama.cpp"))
    parser.add_argument(
        "--file", default="", help="GGUF filename in a Hugging Face repository"
    )
    parser.add_argument(
        "--keep-source", action="store_true", help="Keep the repository on uninstall"
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="Preview uninstall without deleting"
    )
    args = parser.parse_args()
    if args.action == "uninstall":
        return uninstall(keep_source=args.keep_source, dry_run=args.dry_run)
    if args.action == "download":
        return download(args.model_id, args.backend, args.file)
    if args.action == "fit":
        if not args.model_id or args.switch_model_id:
            parser.error("use 'lanllm fit <model source> [--apply]'")
        return fit(args.model_id, args.backend, args.file, args.apply)
    if args.backend or args.file:
        parser.error("--backend and --file are only accepted with 'download' or 'fit'")
    if args.apply:
        parser.error("--apply is only accepted with 'fit'")
    if args.keep_source:
        parser.error("--keep-source is only accepted with 'uninstall'")
    if args.dry_run:
        parser.error("--dry-run is only accepted with 'uninstall'")
    if args.action == "top":
        if args.model_id or args.switch_model_id:
            parser.error("use 'lanllm top [--once] [--interval seconds]'")
        return top(args.once, args.interval)
    if args.once:
        parser.error("--once is only accepted with 'top'")
    if args.action == "model":
        if args.model_id == "switch":
            if not args.switch_model_id:
                parser.error("use 'lanllm model switch <model ID>'")
            return model(args.switch_model_id)
        if args.switch_model_id:
            parser.error("use 'lanllm model switch <model ID>'")
        return model(args.model_id)
    if args.action == "switch":
        if not args.model_id or args.switch_model_id:
            parser.error("use 'lanllm switch <model ID>'")
        return model(args.model_id)
    if args.model_id is not None:
        parser.error("a model ID is only accepted after 'model'")
    if args.action == "status":
        return status()
    if args.action == "nodes":
        return nodes()
    if args.action == "models":
        return models()
    command = {
        "start": ["docker", "compose", "up", "-d", "--build"],
        "stop": ["docker", "compose", "down"],
        "logs": ["docker", "compose", "logs", "-f", "node"],
    }[args.action]
    if args.action == "start":
        setup_store()
    return subprocess.run(
        command, cwd=REPOSITORY, env=os.environ.copy() | configuration(), check=False
    ).returncode


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"lanllm: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
