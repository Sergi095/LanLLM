# Copy this file to lanllm.conf on every node. Paths may differ by node.

[cluster]
peers = ["192.168.1.10", "192.168.1.11"]
total_gpus = 3

[models]
# LanLLM creates and exports this folder. Set a local path on each node.
directory = "/srv/lanllm-store"
default_id = "Qwen/Qwen2.5-14B-Instruct"
# revision = "main"
# token = "hf_..."  # Or set HF_TOKEN in .env instead.

# Optional vLLM settings for the selected model.
[models.profiles."Qwen/Qwen2.5-14B-Instruct"]
tool_call_parser = "hermes"
# Add [models.profiles."owner/repository"] tables for other models.
# Supported keys include served_model_names, tool_call_parser, reasoning_parser,
# tokenizer, dtype, max_model_len, layer_partition, cpu_offload_gb,
# max_num_seqs, max_num_batched_tokens, and gdn_prefill_backend.

[inference]
max_model_len = 2048
gpu_memory_utilization = 0.9
layer_partition = "auto"
llama_rpc_port = 50052
# quantization = "awq"
# dtype = "auto"
# trust_remote_code = false

[api]
port = 8001
control_port = 8501
