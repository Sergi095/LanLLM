# Copy this file to lanllm.conf on every node. Paths may differ by node.

[cluster]
peers = ["192.168.2.33", "192.168.2.26"]
total_gpus = 3

[models]
# Local folder exported by this node when it leads. No NAS is required.
directory = "/srv/lanllm-store"
default_id = "Qwen/Qwen2.5-14B-Instruct"
# revision = "main"
# token = "hf_..."  # Or set HF_TOKEN in .env instead.

[inference]
max_model_len = 2048
gpu_memory_utilization = 0.9
layer_partition = "auto"
# quantization = "awq"
# dtype = "auto"
# trust_remote_code = false

[api]
port = 8001
control_port = 8501
